<Page
    x:Class="Caffeine.Pages.AwakePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Card chrome matching the SettingsCards used across the app. -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="4" MaxWidth="800" HorizontalAlignment="Stretch">

            <TextBlock
                Text="Awake"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,4" />
            <TextBlock
                Text="Keeps your PC and display awake, so your machine won't lock the screen or go to sleep while you're away from the keyboard."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Margin="0,0,0,20" />

            <!-- Hero status card: badge + status + master toggle -->
            <Border Style="{StaticResource StatCardStyle}" Padding="20,18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                        <Border
                            x:Name="BadgeActive"
                            CornerRadius="24"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border
                            x:Name="BadgeInactive"
                            CornerRadius="24"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                        <TextBlock
                            Text="&#x2615;"
                            FontSize="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="StatusTitle"
                            Text="Keeping your screen awake"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="StatusCaption"
                            Text="Your display won't turn off, lock, or start the screensaver"
                            Style="{StaticResource StatLabelStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="2"
                        x:Name="AwakeToggle"
                        OnContent="On"
                        OffContent="Off"
                        MinWidth="0"
                        Margin="0,-2,-8,-2"
                        VerticalAlignment="Center"
                        Toggled="AwakeToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock
                Text="Statistics"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Margin="1,20,0,8" />

            <!-- Lifetime counter: web-countdown style unit tiles -->
            <Border Style="{StaticResource StatCardStyle}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Total time awake" Style="{StaticResource StatLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="YearsText" Text="0" Style="{StaticResource StatNumberStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="years" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="MonthsText" Text="0" Style="{StaticResource StatNumberStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="months" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="DaysText" Text="0" Style="{StaticResource StatNumberStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="days" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock x:Name="HoursText" Text="0" Style="{StaticResource StatNumberStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="hours" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="MinutesText" Text="0" Style="{StaticResource StatNumberStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="minutes" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Current session -->
                <Border Style="{StaticResource StatCardStyle}" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Current session" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionText" Text="—" Style="{StaticResource StatNumberStyle}" />
                        <TextBlock
                            x:Name="SessionCaption"
                            Text="Toggle on to start brewing"
                            Style="{StaticResource StatLabelStyle}" />
                    </StackPanel>
                </Border>

                <!-- Killstreak -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Killstreak" Style="{StaticResource StatLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#x1F525;" FontSize="22" VerticalAlignment="Center" />
                            <TextBlock x:Name="StreakText" Text="0" Style="{StaticResource StatNumberStyle}" />
                            <TextBlock
                                x:Name="StreakUnitText"
                                Text="days"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,3" />
                        </StackPanel>
                        <TextBlock x:Name="BestStreakText" Text="Best: 0 days" Style="{StaticResource StatLabelStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Reserved for the animated character (future feature). -->
            <Grid x:Name="CharacterArea" MinHeight="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
