<Page
    x:Class="Caffeine.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="4" MaxWidth="800" HorizontalAlignment="Stretch">

            <TextBlock
                Text="Settings"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,4" />
            <TextBlock
                Text="Configure how Caffeine behaves."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Margin="0,0,0,20" />

            <TextBlock
                Text="Behavior"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Margin="1,0,0,8" />

            <toolkit:SettingsCard
                Header="Remember state"
                Description="Keep the toggle position after closing — Caffeine starts the way you left it">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="RememberStateToggle"
                    OnContent="On"
                    OffContent="Off"
                    Toggled="RememberStateToggle_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Header="Run in system tray"
                Description="Closing the window keeps Caffeine running in the tray; turn off to exit when the window closes">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="RunInTrayToggle"
                    OnContent="On"
                    OffContent="Off"
                    Toggled="RunInTrayToggle_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Header="Start with Windows"
                Description="Launch Caffeine automatically when you sign in — it starts quietly in the tray">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE770;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="StartWithWindowsToggle"
                    OnContent="On"
                    OffContent="Off"
                    Toggled="StartWithWindowsToggle_Toggled" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
